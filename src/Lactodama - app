    },
    // Cart styles
    cartView: {
      minHeight: "100vh",
      background: NAVY,
      paddingBottom: 120,
    },
    cartHeader: {
      background: NAVY,
      borderBottom: `3px solid ${RED}`,
      padding: "16px 20px",
      display: "flex",
      alignItems: "center",
      gap: 12,
      position: "sticky",
      top: 0,
      zIndex: 100,
    },
    backBtn: {
      background: "rgba(255,255,255,0.1)",
      border: "none",
      borderRadius: 8,
      padding: "8px 14px",
      color: "#fff",
      fontWeight: 700,
      cursor: "pointer",
      fontSize: 14,
    },
    cartTitle: {
      fontSize: 20,
      fontWeight: 900,
      color: "#fff",
    },
    cartItem: {
      display: "flex",
      justifyContent: "space-between",
      alignItems: "center",
      padding: "14px 20px",
      borderBottom: "1px solid rgba(255,255,255,0.08)",
    },
    cartItemName: {
      fontSize: 14,
      fontWeight: 600,
      color: "#fff",
      flex: 1,
      paddingRight: 8,
    },
    cartItemRight: {
      display: "flex",
      flexDirection: "column",
      alignItems: "flex-end",
      gap: 4,
    },
    cartItemTotal: {
      fontSize: 15,
      fontWeight: 900,
      color: "#FFD700",
    },
    cartItemQty: {
      fontSize: 12,
      color: "rgba(255,255,255,0.5)",
    },
    emptyCart: {
      textAlign: "center",
      padding: "60px 20px",
      color: "rgba(255,255,255,0.4)",
      fontSize: 16,
    },
    checkoutBox: {
      position: "fixed",
      bottom: 0,
      left: 0,
      right: 0,
      background: "#0d1a7a",
      borderTop: `3px solid ${RED}`,
      padding: "16px 20px",
    },
    totalRow: {
      display: "flex",
      justifyContent: "space-between",
      marginBottom: 12,
    },
    totalLabel: {
      fontSize: 16,
      color: "rgba(255,255,255,0.7)",
    },
    totalValue: {
      fontSize: 20,
      fontWeight: 900,
      color: "#FFD700",
    },
    inputField: {
      width: "100%",
      padding: "11px 14px",
      borderRadius: 10,
      border: "2px solid rgba(255,255,255,0.2)",
      background: "rgba(255,255,255,0.08)",
      color: "#fff",
      fontSize: 14,
      marginBottom: 10,
      boxSizing: "border-box",
      outline: "none",
    },
    sendBtn: {
      width: "100%",
      padding: "14px",
      background: "#25D366",
      border: "none",
      borderRadius: 12,
      color: "#fff",
      fontSize: 16,
      fontWeight: 900,
      cursor: "pointer",
      letterSpacing: 0.5,
    },
    successView: {
      display: "flex",
      flexDirection: "column",
      alignItems: "center",
      justifyContent: "center",
      minHeight: "100vh",
      padding: 32,
      textAlign: "center",
    },
    successIcon: {
      fontSize: 72,
      marginBottom: 20,
    },
    successTitle: {
      fontSize: 26,
      fontWeight: 900,
      color: "#25D366",
      marginBottom: 10,
    },
    successSub: {
      fontSize: 15,
      color: "rgba(255,255,255,0.6)",
      marginBottom: 32,
    },
    newOrderBtn: {
      background: RED,
      border: "none",
      borderRadius: 12,
      padding: "14px 32px",
      color: "#fff",
      fontSize: 16,
      fontWeight: 700,
      cursor: "pointer",
    },
  };

  if (view === "success") {
    return (
      <div style={styles.app}>
        <div style={styles.successView}>
          <div style={styles.successIcon}>✅</div>
          <div style={styles.successTitle}>Pedido Enviado!</div>
          <div style={styles.successSub}>
            Seu pedido foi encaminhado via WhatsApp para a Lactodama. Em breve entrarão em contato.
          </div>
          <button style={styles.newOrderBtn} onClick={() => { setCart({}); setClientName(""); setClientPhone(""); setView("catalog"); }}>
            Fazer Novo Pedido
          </button>
        </div>
      </div>
    );
  }

  if (view === "cart") {
    return (
      <div style={styles.cartView}>
        <div style={styles.cartHeader}>
          <button style={styles.backBtn} onClick={() => setView("catalog")}>← Voltar</button>
          <div style={styles.cartTitle}>🛒 Meu Pedido</div>
        </div>
        {cartItems.length === 0 ? (
          <div style={styles.emptyCart}>
            <div style={{ fontSize: 48, marginBottom: 12 }}>🛒</div>
            <div>Seu carrinho está vazio.</div>
            <div style={{ marginTop: 8, fontSize: 13 }}>Adicione produtos no catálogo!</div>
          </div>
        ) : (
          <>
            {cartItems.map(item => (
              <div key={item.id} style={styles.cartItem}>
                <div>
                  <div style={styles.cartItemName}>{item.name}</div>
                  <div style={{ display: "flex", alignItems: "center", gap: 8, marginTop: 4 }}>
                    <button style={styles.qtyBtn} onClick={() => removeFromCart(item.id)}>−</button>
                    <span style={styles.qtyNum}>{item.qty}</span>
                    <button style={styles.qtyBtn} onClick={() => addToCart(item.id)}>+</button>
                    <span style={styles.cartItemQty}>{item.unit}</span>
                  </div>
                </div>
                <div style={styles.cartItemRight}>
                  <div style={styles.cartItemTotal}>R$ {(item.price * item.qty).toFixed(2)}</div>
                  <div style={styles.cartItemQty}>R$ {item.price.toFixed(2)}/{item.unit}</div>
                </div>
              </div>
            ))}
          </>
        )}
        {cartItems.length > 0 && (
          <div style={styles.checkoutBox}>
            <div style={styles.totalRow}>
              <span style={styles.totalLabel}>Total aprox.</span>
              <span style={styles.totalValue}>R$ {total.toFixed(2)}</span>
            </div>
            <input
              style={styles.inputField}
              placeholder="Seu nome / nome do estabelecimento"
              value={clientName}
              onChange={e => setClientName(e.target.value)}
            />
            <input
              style={styles.inputField}
              placeholder="Seu telefone (opcional)"
              value={clientPhone}
              onChange={e => setClientPhone(e.target.value)}
            />
            <button
              style={{ ...styles.sendBtn, opacity: clientName ? 1 : 0.5 }}
              disabled={!clientName}
              onClick={generateWhatsApp}
            >
              📲 Enviar Pedido pelo WhatsApp
            </button>
          </div>
        )}
      </div>
    );
  }

  return (
    <div style={styles.app}>
      <div style={styles.header}>
        <div style={styles.logo}>
          <div style={styles.logoTitle}>LD LACTODAMA</div>
          <div style={styles.logoSub}>QUEIJOS & CIA</div>
        </div>
        <button style={styles.cartBtn} onClick={() => setView("cart")}>
          🛒 {cartCount > 0 && <span style={{ background: "#fff", color: RED, borderRadius: "50%", width: 20, height: 20, display: "flex", alignItems: "center", justifyContent: "center", fontSize: 12, fontWeight: 900 }}>{cartCount}</span>}
          {cartCount === 0 ? "Carrinho" : "Ver Pedido"}
        </button>
      </div>

      <div style={styles.searchBar}>
        <input
          style={styles.searchInput}
          placeholder="🔍 Buscar produto..."
          value={search}
          onChange={e => setSearch(e.target.value)}
        />
      </div>

      <div style={styles.catScroll}>
        {categories.map(cat => (
          <button
            key={cat}
            style={styles.catBtn(selectedCategory === cat)}
            onClick={() => setSelectedCategory(cat)}
          >
            {cat === "Todos" ? "🏪 Todos" : `${categoryEmojis[cat] || ""} ${cat}`}
          </button>
        ))}
      </div>

      <div style={styles.grid}>
        {filtered.map(product => {
          const qty = cart[product.id] || 0;
          return (
            <div key={product.id} style={styles.card}>
              <div style={styles.cardCat}>{categoryEmojis[product.category]} {product.category}</div>
              <div style={styles.cardName}>{product.name}</div>
              <div>
                <div style={styles.cardPrice}>R$ {product.price.toFixed(2)}</div>
                <div style={styles.cardUnit}>por {product.unit}</div>
                <div style={styles.cardNeg}>Valor negociável</div>
              </div>
              <div style={styles.qtyRow}>
                {qty > 0 ? (
                  <>
                    <button style={styles.qtyBtn} onClick={() => removeFromCart(product.id)}>−</button>
                    <span style={styles.qtyNum}>{qty}</span>
                    <button style={styles.qtyBtn} onClick={() => addToCart(product.id)}>+</button>
                  </>
                ) : (
                  <button
                    style={{ ...styles.qtyBtn, background: RED, color: "#fff", width: "100%", borderRadius: 8, padding: "6px 0", fontSize: 13, fontWeight: 700 }}
                    onClick={() => addToCart(product.id)}
                  >
                    + Adicionar
                  </button>
                )}
              </div>
            </div>
          );
        })}
        {filtered.length === 0 && (
          <div style={{ gridColumn: "1/-1", textAlign: "center", padding: 40, color: "rgba(255,255,255,0.4)" }}>
            Nenhum produto encontrado.
          </div>
        )}
      </div>
    </div>
  );
}
